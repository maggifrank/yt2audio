# yt-library configuration.
# install.sh copies this file to /etc/yt-library/yt-library.env on first install
# (it never overwrites an existing one). Edit that copy, then:
#   systemctl restart yt-library
# Paths, YTL_CLEANUP_ONCALENDAR and the timer schedule are applied by re-running
# install.sh (it writes the systemd drop-ins from these values).
#
# Format: plain KEY=value lines, read both by systemd (EnvironmentFile=) and by
# the shell (install.sh / the yt-library wrapper). Keep comments on their own
# lines, do not quote values, and do not use spaces in paths.
# This repository is public: never put real secrets in this example file.

# Where the audio library is stored (also holds .tmp/ job dirs and .previews/)
YTL_LIBRARY_DIR=/srv/music
# SQLite database; keep it on local disk (not NFS/SMB)
YTL_DB_PATH=/var/lib/yt-library/library.db
# Listen address: the LXC's internal IP when Caddy runs on another host, 127.0.0.1 when on the same host
YTL_HOST=127.0.0.1
# Listen port
YTL_PORT=8080
# Lifetime options offered in the UI (units: s m h d w)
YTL_LIFETIMES=1h,1d,7d,30d
# Lifetime preselected in the UI
YTL_DEFAULT_LIFETIME=1d
# Upper bound for any song's lifetime, including extensions
YTL_MAX_LIFETIME=30d
# systemd OnCalendar schedule for the cleanup timer (re-run install.sh after changing)
YTL_CLEANUP_ONCALENDAR=*:0/15
# Maximum number of tracks one job (playlist) may download
YTL_MAX_TRACKS_PER_JOB=100
# Tracks longer than this are skipped
YTL_MAX_TRACK_DURATION=2h
# Maximum number of queued jobs before new submissions get 503
YTL_MAX_QUEUED_JOBS=20
# Total library size limit (units: K M G T)
YTL_STORAGE_QUOTA=20G
# Job submissions allowed per client IP per window (count/window)
YTL_RATE_LIMIT=30/1h
# Comma list of IPs/CIDRs whose X-Forwarded-For is trusted (the Caddy host's IP)
YTL_TRUSTED_PROXIES=127.0.0.1
# Optional extra origins allowed for POST/DELETE, comma list (same-host origin is always allowed)
YTL_ALLOWED_ORIGINS=
# How long edit previews are kept
YTL_PREVIEW_TTL=30m
# Running jobs older than this are marked failed by cleanup
YTL_JOB_TIMEOUT=3h
# Path to the yt2audio script
YTL_YT2AUDIO=/usr/local/bin/yt2audio
# Path to the audiocrop script
YTL_AUDIOCROP=/usr/local/bin/audiocrop
# Path to yt-dlp
YTL_YTDLP=/usr/local/bin/yt-dlp
