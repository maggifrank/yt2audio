#!/usr/bin/env python3
"""Fake yt-dlp for tests: no network. Video ids starting with 'X' fail like private videos."""
import json, os, re, subprocess, sys

args = sys.argv[1:]
url = args[-1]
EXT = {"mp3": "mp3", "m4a": "m4a", "opus": "opus", "vorbis": "ogg", "wav": "wav", "flac": "flac", "aac": "aac", "alac": "m4a"}
CODEC = {"mp3": ["-c:a", "libmp3lame"], "m4a": ["-c:a", "aac"], "opus": ["-c:a", "libopus"], "vorbis": ["-c:a", "libvorbis"],
         "wav": [], "flac": [], "aac": ["-c:a", "aac"], "alac": ["-c:a", "alac"]}
IDS = ["AAAAAAAAAAA", "BBBBBBBBBBB", "XXXXXXXXXXX", "LLLLLLLLLLL"]

def vid(u):
    m = re.search(r"v=([\w-]{11})", u)
    return m.group(1) if m else None

if "-J" in args:
    if "list=" in url and "--no-playlist" not in args:
        entries = [{"id": i, "title": f"Song {i[0]} / \"quoted\"", "uploader": "Tester",
                    "duration": 7200 * 3 if i[0] == "L" else 3} for i in IDS]
        print(json.dumps({"_type": "playlist", "title": "Test list", "entries": entries}))
    else:
        v = vid(url)
        if not v:
            print("ERROR: Unsupported URL", file=sys.stderr); sys.exit(1)
        print(json.dumps({"id": v, "title": f"Song {v[0]}", "uploader": "Tester", "duration": 3}))
    sys.exit(0)

v = vid(url)
fmt = args[args.index("--audio-format") + 1]
tmpl = args[args.index("-o") + 1]
state = os.environ.get("FAKE_YTDLP_STATE")
if v and v.startswith("F") and state:
    marker = os.path.join(state, v)
    if not os.path.exists(marker):  # flaky: first attempt fails like YouTube's intermittent 403
        open(marker, "w").close()
        print("ERROR: unable to download video data: HTTP Error 403: Forbidden", file=sys.stderr)
        sys.exit(1)
if v is None or v.startswith("X"):
    print(f"ERROR: [youtube] {v}: Private video. Sign in if you've been granted access", file=sys.stderr)
    sys.exit(1)
out = tmpl.replace("%(playlist_index&{}- |)s", "").replace("%(title)s", f"Song {v[0]}").replace("%(ext)s", EXT[fmt])
trace = os.environ.get("FAKE_YTDLP_TRACE")
if trace:
    import time
    with open(trace, "a") as f:
        f.write(f"start {time.time()}\n")
    time.sleep(float(os.environ.get("FAKE_YTDLP_SLEEP", "0")))
subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-f", "lavfi", "-i", f"sine=frequency=440:duration={50 if v[0] == 'R' else 3}",
                "-ac", "2", *CODEC[fmt], out], check=True)
if trace:
    with open(trace, "a") as f:
        f.write(f"end {time.time()}\n")
if "--print" in args:
    print(os.path.abspath(out))
